{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Pin the source root. Without this TypeScript infers it from the common
    // parent of all inputs — and because prisma/seed.ts lives outside src/,
    // that parent became the project root, so output landed in dist/src/main.js
    // instead of dist/main.js and the deploy couldn't find its entrypoint.
    "rootDir": "./src",
    // Off for production: Render caches the build dir, and a stale
    // .tsbuildinfo makes the compiler skip emitting entirely.
    "incremental": false
  },
  // prisma/ is run through ts-node (seeding), never compiled into dist.
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "prisma",
    "**/*spec.ts"
  ]
}
